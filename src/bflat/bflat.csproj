<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="bflat.variant.props" />
  <Import Project="bflat.build.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(DotnetVersion).0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every .NET analyzer is on; .editorconfig decides which ones are
         errors, which stay warnings and which are off (with reasons). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version Condition="'$(Version)' == ''">42.42.42.42</Version>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>BflatRuntimeVersion</_Parameter1>
      <_Parameter2>$(BlobsVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>MicrosoftCodeAnalysisCSharpVersion</_Parameter1>
      <_Parameter2>$(MicrosoftCodeAnalysisCSharpVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>BflatVariant</_Parameter1>
      <_Parameter2>$(Variant)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BFlat.Compiler" Version="$(RuntimeVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeArtifact Include="bflat-compiler-native-$(CompilerHost)" />
    <RuntimeArtifact Include="@(SupportedTarget->'bflat-libs-%(Identity)')" />
    <RuntimeArtifact Include="bflat-refs" />
  </ItemGroup>

  <ItemGroup>
    <CompilerBlob Include="compiler-$(CompilerHost)" />

    <SdkBlob Include="@(SupportedTarget->'libs-%(Identity)')">
      <Os>%(Os)</Os>
      <Lib>%(Lib)</Lib>
      <Arch>%(Arch)</Arch>
    </SdkBlob>

    <Blob Include="@(CompilerBlob);@(SdkBlob)" />
  </ItemGroup>

  <PropertyGroup>
    <_CompilerNupkgName>bflat.compiler.$(RuntimeVersion).nupkg</_CompilerNupkgName>
    <_LocalPackagesDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'packages'))</_LocalPackagesDir>
    <_CompilerNupkgLocalPath>$([MSBuild]::NormalizePath('$(_LocalPackagesDir)', '$(_CompilerNupkgName)'))</_CompilerNupkgLocalPath>
    <!-- Marker file recording which BlobsVersion produced the cached nupkg.
         _CompilerNupkgName itself does not include BlobsVersion (NuGet
         requires the canonical filename), so we track the active blob set
         via this sidecar file. When BlobsVersion changes, the marker
         disappears and DownloadCompilerNupkg re-fetches. -->
    <_CompilerNupkgVersionMarker>$(_CompilerNupkgLocalPath).$(BlobsVersion).version</_CompilerNupkgVersionMarker>
  </PropertyGroup>

  <Target Name="CreateCompilerLayout"
          DependsOnTargets="ExtractHostCompiler;ExtractCompilerBlob;ExtractRefs;ExtractLibraries;ExtractSdkBlobs">
    <!-- The native modules: bflat-modules reads each module's
         bflat-manifest.json and copies it, with the files it names, to
         lib/modules/<name>/ (see docs/manifest.md). Built here and run with
         the SDK's own host, because bflat itself is not usable before its
         layout exists. The global properties of a BuildLayouts pass
         (OutputPath and friends) are for bflat, not for the tool. Restore
         runs as its own pass (a new session id forces a fresh evaluation),
         because the tool is not a reference of bflat and so the bflat
         restore does not cover it. -->
    <PropertyGroup>
      <_BflatModulesProject>$(MSBuildThisFileDirectory)..\bflat-modules\bflat-modules.csproj</_BflatModulesProject>
      <_BflatModulesRemoved>OutputPath;IntermediateOutputPath;CompilerHost;DownloadCachePath;Variant;DotnetVersion;Flavor;Platform</_BflatModulesRemoved>
    </PropertyGroup>
    <MSBuild Projects="$(_BflatModulesProject)"
             Targets="Restore"
             Properties="Configuration=Release;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
             RemoveProperties="$(_BflatModulesRemoved)" />
    <MSBuild Projects="$(_BflatModulesProject)"
             Targets="Build"
             Properties="Configuration=Release"
             RemoveProperties="$(_BflatModulesRemoved)">
      <Output TaskParameter="TargetOutputs" ItemName="_BflatModulesTool" />
    </MSBuild>
    <PropertyGroup>
      <_DotnetHost>$(DOTNET_HOST_PATH)</_DotnetHost>
      <_DotnetHost Condition="'$(_DotnetHost)' == ''">dotnet</_DotnetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_DotnetHost)&quot; &quot;@(_BflatModulesTool)&quot; pack &quot;$(MSBuildThisFileDirectory)modules&quot; &quot;$(OutputPath)lib/modules&quot;"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=LatestMajor" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)bflat-manifest.schema.json"
          DestinationFolder="$(OutputPath)" />

    <!-- crt1 for the platforms: musl's crt1.o with _start/_start_c renamed,
         so that the platform entry point defines _start. -->
    <PropertyGroup>
      <_LlvmObjcopy>llvm-objcopy</_LlvmObjcopy>
      <_MuslCrt1>$([MSBuild]::NormalizePath($(OutputPath), 'lib', 'linux', 'riscv64', 'musl', 'crt1.o'))</_MuslCrt1>
      <_PlatformCrt1>$([MSBuild]::NormalizePath($(OutputPath), 'lib', 'linux', 'riscv64', 'musl', 'crt1-platform.o'))</_PlatformCrt1>
    </PropertyGroup>
    <Exec Command="&quot;$(_LlvmObjcopy)&quot; --redefine-sym _start_c=_star2_c --redefine-sym _start=_star2 &quot;$(_MuslCrt1)&quot; &quot;$(_PlatformCrt1)&quot;"
          ConsoleToMSBuild="true" />

    <!-- patch-elf script -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)scripts\patch_elf.py"
          DestinationFiles="$(OutputPath)patch_elf.py" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)scripts\check_wrap_symbols.py"
          DestinationFiles="$(OutputPath)check_wrap_symbols.py" />
  </Target>

  <Target Name="ValidateVariant"
          BeforeTargets="Restore;CollectPackageReferences;DownloadCompilerNupkg;Build">
    <Error Condition="'$(Variant)' != 'perf' and '$(Variant)' != 'min'"
           Text="Unknown Variant '$(Variant)'. Supported variants: perf, min (see bflat.variant.props for the release tag each resolves to)." />
    <Error Condition="'$(DotnetVersion)' != '10' and '$(DotnetVersion)' != '11'"
           Text="Unknown DotnetVersion '$(DotnetVersion)'. Supported versions: 10, 11." />
    <Error Condition="'$(RuntimeReleaseTag)' == ''"
           Text="No dotnet-riscv release tag for DotnetVersion=$(DotnetVersion) Variant=$(Variant) (see bflat.variant.props)." />
  </Target>

  <!-- Variants share bin/ and obj/, so extract semaphores from a previous
       build of variant A stay newer than A's cached zips even after variant B
       has overwritten the output tree. Wipe them whenever the variant being
       built differs from the last one extracted, forcing re-extraction from
       the (per-variant) download cache. -->
  <PropertyGroup>
    <_VariantStamp>$(IntermediateOutputPath)variant-$(BlobsVersion).stamp</_VariantStamp>
  </PropertyGroup>
  <Target Name="ResetVariantState"
          BeforeTargets="ExtractHostCompiler;ExtractCompilerBlob;ExtractRefs;ExtractLibraries;ExtractSdkBlobs"
          Condition="!Exists('$(_VariantStamp)')">
    <ItemGroup>
      <_StaleVariantFiles Include="$(IntermediateOutputPath)*.semaphore" />
      <_StaleVariantFiles Include="$(IntermediateOutputPath)variant-*.stamp" />
    </ItemGroup>
    <Delete Files="@(_StaleVariantFiles)" />
    <Touch Files="$(_VariantStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Runtime artifact caches are keyed by $(BlobsVersion), not
       $(RuntimeVersion): the plain version is identical across variants and
       would let one variant's cached zips/semaphores satisfy the other's. -->
  <Target Name="DownloadRuntimeArtifacts"
          AfterTargets="CollectPackageReferences"
          Condition="!Exists(@(RuntimeArtifact->'$(DownloadCachePath)%(Identity)-$(BlobsVersion).zip'))"
          Outputs="@(RuntimeArtifact->'$(DownloadCachePath)%(Identity)-$(BlobsVersion).zip')">

    <DownloadFile SourceUrl="$(RuntimeUri)$(RuntimeReleaseTag)/%(RuntimeArtifact.Identity).zip"
                  Retries="3"
                  DestinationFolder="$(DownloadCachePath)"
                  DestinationFileName="%(RuntimeArtifact.Identity)-$(BlobsVersion).zip" />
  </Target>

  <Target Name="DownloadBlobs"
          AfterTargets="CollectPackageReferences"
          Condition="!Exists(@(Blob->'$(DownloadCachePath)%(Identity)-$(BlobsVersion).zip'))"
          Outputs="@(Blob->'$(DownloadCachePath)%(Identity)-$(BlobsVersion).zip')">

    <DownloadFile SourceUrl="$(BlobsUri)$(RuntimeReleaseTag)/%(Blob.Identity).zip"
                  Retries="3"
                  DestinationFolder="$(DownloadCachePath)"
                  DestinationFileName="%(Blob.Identity)-$(BlobsVersion).zip" />
  </Target>

  <!--
    Download BFlat.Compiler nupkg into the local packages folder when it is
    missing, then clear the global NuGet cache entry for that exact
    package+version so the subsequent Restore re-extracts from our local
    source instead of any stale cached copy.
  -->
  <Target Name="DownloadCompilerNupkg"
          BeforeTargets="Restore"
          Condition="!Exists('$(_CompilerNupkgLocalPath)') or !Exists('$(_CompilerNupkgVersionMarker)')">

    <Message Text="Downloading $(_CompilerNupkgName) (BlobsVersion=$(BlobsVersion)) ..." Importance="High" />

    <MakeDir Directories="$(_LocalPackagesDir)" />

    <!-- Drop the cached nupkg and any stale version markers; the marker for
         the previous BlobsVersion is no longer authoritative. -->
    <Delete Files="$(_CompilerNupkgLocalPath)"
            Condition="Exists('$(_CompilerNupkgLocalPath)')" />
    <ItemGroup>
      <_StaleVersionMarkers Include="$(_LocalPackagesDir)/$(_CompilerNupkgName).*.version" />
    </ItemGroup>
    <Delete Files="@(_StaleVersionMarkers)" />

    <DownloadFile SourceUrl="$(BlobsUri)$(RuntimeReleaseTag)/$(_CompilerNupkgName)"
                  Retries="3"
                  DestinationFolder="$(_LocalPackagesDir)"
                  DestinationFileName="$(_CompilerNupkgName)" />

    <PropertyGroup>
      <_NuGetGlobalPkgDir Condition="'$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_NuGetGlobalPkgDir>
      <_NuGetGlobalPkgDir Condition="'$(_NuGetGlobalPkgDir)' == '' and '$(OS)' != 'Windows_NT'">$(HOME)/.nuget/packages</_NuGetGlobalPkgDir>
      <_NuGetGlobalPkgDir Condition="'$(_NuGetGlobalPkgDir)' == '' and '$(OS)' == 'Windows_NT'">$(USERPROFILE)\.nuget\packages</_NuGetGlobalPkgDir>
      <_NuGetCacheEntry>$([MSBuild]::NormalizePath('$(_NuGetGlobalPkgDir)', 'bflat.compiler', '$(RuntimeVersion)'))</_NuGetCacheEntry>
    </PropertyGroup>

    <Message Text="Clearing NuGet cache: $(_NuGetCacheEntry)" Importance="High"
             Condition="Exists('$(_NuGetCacheEntry)')" />
    <RemoveDir Directories="$(_NuGetCacheEntry)"
               Condition="Exists('$(_NuGetCacheEntry)')" />

    <Touch Files="$(_CompilerNupkgVersionMarker)" AlwaysCreate="true" />
  </Target>

  <Target Name="ExtractHostCompiler"
          Inputs="$(DownloadCachePath)bflat-compiler-native-$(CompilerHost)-$(BlobsVersion).zip"
          Outputs="$(IntermediateOutputPath)bflat-compiler-native-$(CompilerHost)-$(BlobsVersion).semaphore">

    <Unzip SourceFiles="$(DownloadCachePath)bflat-compiler-native-$(CompilerHost)-$(BlobsVersion).zip"
           DestinationFolder="$(OutputPath)" />

    <Touch Files="$(IntermediateOutputPath)\bflat-compiler-native-$(CompilerHost)-$(BlobsVersion).semaphore"
           AlwaysCreate="true" />
  </Target>

  <Target Name="ExtractCompilerBlob"
          Inputs="$(DownloadCachePath)compiler-$(CompilerHost)-$(BlobsVersion).zip"
          Outputs="$(IntermediateOutputPath)compiler-$(CompilerHost)-$(BlobsVersion).semaphore">

    <Unzip SourceFiles="$(DownloadCachePath)compiler-$(CompilerHost)-$(BlobsVersion).zip"
           DestinationFolder="$(OutputPath)" />

    <Exec Command="chmod +x $(OutputPath)bin/lld" Condition="'$(OS)' != 'Windows_NT' and $(CompilerHost.StartsWith('linux'))" />
    <Exec Command="chmod +x $(OutputPath)bin/llvm-objcopy" Condition="'$(OS)' != 'Windows_NT' and $(CompilerHost.StartsWith('linux'))" />

    <Touch Files="$(IntermediateOutputPath)\compiler-$(CompilerHost)-$(BlobsVersion).semaphore"
           AlwaysCreate="true" />
  </Target>

  <Target Name="ExtractRefs"
          Inputs="$(DownloadCachePath)bflat-refs-$(BlobsVersion).zip"
          Outputs="$(IntermediateOutputPath)bflat-refs-$(BlobsVersion).semaphore">

    <Unzip SourceFiles="$(DownloadCachePath)bflat-refs-$(BlobsVersion).zip"
           DestinationFolder="$(OutputPath)ref" />

    <Touch Files="$(IntermediateOutputPath)\bflat-refs-$(BlobsVersion).semaphore"
           AlwaysCreate="true" />
  </Target>

  <Target Name="ExtractLibraries"
          Inputs="@(SupportedTarget->'$(DownloadCachePath)bflat-libs-%(Identity)-$(BlobsVersion).zip')"
          Outputs="@(SupportedTarget->'$(IntermediateOutputPath)\bflat-libs-%(Identity)-$(BlobsVersion).semaphore')">

    <Unzip SourceFiles="$(DownloadCachePath)bflat-libs-%(SupportedTarget.Identity)-$(BlobsVersion).zip"
           DestinationFolder="$(OutputPath)lib\%(SupportedTarget.LibPath)" />

    <Copy SourceFiles="$(OutputPath)lib\%(SupportedTarget.LibPath)\zerolibnative.obj"
          DestinationFolder="$(OutputPath)lib\uefi\arm64\"
          Condition="'%(SupportedTarget.Identity)' == 'windows-arm64'" />

    <Touch Files="$(IntermediateOutputPath)\bflat-libs-%(SupportedTarget.Identity)-$(BlobsVersion).semaphore"
           AlwaysCreate="true" />
  </Target>

  <Target Name="ExtractSdkBlobs"
          Inputs="@(SdkBlob->'$(DownloadCachePath)%(Identity)-$(BlobsVersion).zip')"
          Outputs="@(SdkBlob->'$(IntermediateOutputPath)\%(Identity)-$(BlobsVersion).semaphore')">

    <Message Text="Extracting SDK blob for os=%(SdkBlob.Os) arch=%(SdkBlob.Arch) lib=%(SdkBlob.Lib)..." Importance="High" />
    <Unzip SourceFiles="$(DownloadCachePath)%(SdkBlob.Identity)-$(BlobsVersion).zip"
           DestinationFolder="$(OutputPath)lib/%(SdkBlob.Os)/%(SdkBlob.Arch)/%(SdkBlob.Lib)" />

    <Touch Files="$(IntermediateOutputPath)\%(SdkBlob.Identity)-$(BlobsVersion).semaphore"
           AlwaysCreate="true" />
  </Target>

  <Target Name="BuildLayouts"
          Inputs="@(SupportedHost)"
          Outputs="$(LayoutsDirectory)obj\%(SupportedHost.Identity)\semaphore"
          DependsOnTargets="Build">

    <Message Text="Creating layout for %(SupportedHost.Identity)..." Importance="High" />

    <PropertyGroup>
      <LayoutOutputPath>$(LayoutsDirectory)%(SupportedHost.Identity)\</LayoutOutputPath>
      <IntermediateLayoutOutputPath>$(LayoutsDirectory)obj\%(SupportedHost.Identity)\</IntermediateLayoutOutputPath>
      <BflatName>bflat</BflatName>
      <BflatName Condition="'%(SupportedHost.OS)' == 'windows'">bflat.exe</BflatName>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateLayoutOutputPath)" />

    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="DownloadRuntimeArtifacts;DownloadBlobs;CreateCompilerLayout"
             RunEachTargetSeparately="true"
             Properties="OutputPath=$(LayoutOutputPath);
                         CompilerHost=%(SupportedHost.Identity);
                         DownloadCachePath=$(DownloadCachePath);
                         IntermediateOutputPath=$(IntermediateLayoutOutputPath)" />

    <ItemGroup>
      <BflatArg Include="@(Compile->'&quot;%(Identity)&quot;')" />
      <BflatArg Include="--os:%(SupportedHost.OS)" />
      <BflatArg Include="--arch:%(SupportedHost.Arch)" />
      <BflatArg Include="--no-globalization" />
      <BflatArg Include="--no-exception-messages" />
      <BflatArg Include="--no-pie" />
      <BflatArg Include="-o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\$(BflatName)&quot;" />
      <BflatArg Include="@(RuntimeCopyLocalItems->'-r:&quot;%(Identity)&quot;')" />
    </ItemGroup>

    <WriteLinesToFile File="$(IntermediateLayoutOutputPath)\runbflat.rsp"
                      Lines="@(BflatArg)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <Exec Command="&quot;$(RunCommand)&quot; build @&quot;$(IntermediateLayoutOutputPath)\runbflat.rsp&quot;" />

    <MakeDir Directories="$(LayoutsDirectory)%(SupportedHost.Identity)\lib\uefi\x64"
             Condition="!Exists('$(LayoutsDirectory)%(SupportedHost.Identity)\lib\uefi\x64')" />
    <MakeDir Directories="$(LayoutsDirectory)%(SupportedHost.Identity)\lib\uefi\arm64"
             Condition="!Exists('$(LayoutsDirectory)%(SupportedHost.Identity)\lib\uefi\arm64')" />
    <MakeDir Directories="$(LayoutsDirectory)%(SupportedHost.Identity)\lib\windows\x86"
             Condition="!Exists('$(LayoutsDirectory)%(SupportedHost.Identity)\lib\windows\x86')" />

    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d LINUX -d X64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\linux\x64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d LINUX -d ARM64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\linux\arm64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d LINUX -d RISCV64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\linux\riscv64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d WINDOWS -d X64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\windows\x64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d WINDOWS -d ARM64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\windows\arm64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d WINDOWS -d X86 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\windows\x86\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d UEFI -d X64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\uefi\x64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d UEFI -d ARM64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\lib\uefi\arm64\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
    <Exec Condition="false" Command="&quot;$(RunCommand)&quot; build-il --deterministic --stdlib:none -d LINUX -d X64 -o:&quot;$(LayoutsDirectory)%(SupportedHost.Identity)\ref\zerolib.dll&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\zerolib" />
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- CreateCompilerLayout stages the native riscv64 modules (module.o built by
       build.sh, script.ld, patched crt1, ...) into the compiler layout. It is
       part of every normal build, but a pure C#-analyzer pass (dotnet build
       -warnaserror, no build.sh) has none of those .o files and only needs the
       managed compile - let it opt out with -p:SkipCompilerLayout=true. -->
  <PropertyGroup Condition="'$(SkipCompilerLayout)' != 'true'">
    <BuildDependsOn>$(BuildDependsOn);CreateCompilerLayout</BuildDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".*.cs" />
  </ItemGroup>

</Project>
