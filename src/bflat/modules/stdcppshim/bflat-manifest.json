{
  "$schema": "../../bflat-manifest.schema.json",
  "schema": 2,
  "name": "stdcppshim",
  "description": "The C++ runtime pieces the NativeAOT runtime needs",
  "sources": [
    {"file": "module.cpp", "when": {"arch": "riscv64"}},
    {"file": "module.cpp", "output": "module.rv32.o", "when": {"arch": "riscv32"}}
  ],
  "objects": [
    {"file": "module.o", "group": "whole-archive", "order": 20, "when": {"arch": "riscv64"}},
    {"file": "module.rv32.o", "group": "whole-archive", "order": 20, "when": {"arch": "riscv32"}}
  ]
}
