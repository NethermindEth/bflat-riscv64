{
  "$schema": "../../bflat-manifest.schema.json",
  "schema": 2,
  "name": "zkvm_zisk_sim",
  "description": "The ZisK simulator platform: the ZisK entry point with a debugging memory map",
  "note": "No 'no-console' flag: the simulator keeps the host console and host stdio.",
  "platform": {
    "aliases": {"libc": "zisk_sim"},
    "base": {"os": "linux", "arch": "riscv64", "libc": "musl"},
    "requires": ["nofp", "ubootstrap", "stdcppshim", "rhp", "gs_cookie", "rhp_native", "pal", "eh", "tls",
                 "rng_stupid", "rust_sys", "ugc-zero", "nothread", "noos", "zisk_subst"],
    "linker_script": "script.ld",
    "entry": "../zkvm_zisk/module.o"
  }
}
