<Project>
  <!-- The runtime release that bflat bundles. bflat builds for .NET 11 only,
       with the perf runtime of dotnet-riscv. -->
  <PropertyGroup>
    <RuntimeUri>https://github.com/NethermindEth/dotnet-riscv/releases/download/</RuntimeUri>
    <BlobsUri>https://github.com/NethermindEth/dotnet-riscv/releases/download/</BlobsUri>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet version of the bflat.compiler package shipped inside the
         release. The .NET 11 releases still ship the package versioned
         10.0.0 (bflat.compiler.10.0.0.nupkg). -->
    <RuntimeVersion>10.0.0</RuntimeVersion>

    <!-- dotnet-riscv release tag. The tag is the SDK version of the VMR the
         runtime was built from plus the fixup profile: "upstream-perf" is the
         soft-float (lp64/rv64im) series meant for dotnet/runtime with the
         zkVM code-quality patches on top. The release must be signed
         (docs/signing.md). -->
    <RuntimeReleaseTag>11.0.100-upstream-perf.r400</RuntimeReleaseTag>

    <!-- Whether the release has the linux-x64 target of bflat (the x64 JIT,
         runtime and glibc sysroot that the runtime-x64 job of dotnet-riscv
         makes). -p:BflatTargetLinuxX64=false builds without it. -->
    <BflatTargetLinuxX64 Condition="'$(BflatTargetLinuxX64)' == ''">true</BflatTargetLinuxX64>

    <!-- The package carries the widening-cast and Zb lowering fixes from
         dotnet-riscv#9. bflat reports it as the compiler capability
         "zb-lowering-fixes", which platform manifests can test (a platform
         whose decoder has Zba/Zbb/Zbs enables them only then). -->
    <DefineConstants>$(DefineConstants);RISCV64_ZB_LOWERING_FIXES</DefineConstants>

    <!-- Cache key for everything fetched per release. RuntimeVersion stays
         the plain NuGet version: every release ships
         bflat.compiler.$(RuntimeVersion).nupkg, so anything cached
         per-release must be keyed by BlobsVersion, not RuntimeVersion. -->
    <BlobsVersion>$(RuntimeReleaseTag)</BlobsVersion>
    <MicrosoftCodeAnalysisCSharpVersion>4.8.0-3.final</MicrosoftCodeAnalysisCSharpVersion>
  </PropertyGroup>

</Project>
