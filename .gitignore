syntax: glob

layouts
[Bb]in/
[Oo]bj/
launchSettings.json
.vs/
msbuild.binlog
._*
/src/bflat/modules/*/*.o
.DS_Store
/.old
/src/bflat/modules/ugc-zero/src
/src/bflat/modules/ugc-zero/release
/src/packages
_site
*.stamp

# module test/fuzz build outputs, incl. the corpus libFuzzer grows.
# Only the hand-written tests/fuzz/seeds/ are tracked.
/src/bflat/modules/tests/out/*
/src/bflat/modules/tests/fuzz/out/
crash-*

# libFuzzer slow-unit reports
slow-unit-*
timeout-*
leak-*
oom-*

